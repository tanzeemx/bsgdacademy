rules_version = '2';

// BSGD Academy Firestore rules (first hardening pass).
// Deny by default. Roles are read from trusted documents that clients cannot
// write: users/{uid}.role == 'admin' | 'teacher', or a teachers/{uid} doc.
// Admin/teacher accounts must be provisioned from the Firebase Console or a
// trusted backend. See SECURITY.md for known gaps.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function userPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }
    function hasUserDoc() { return signedIn() && exists(userPath()); }
    function isAdmin() { return hasUserDoc() && get(userPath()).data.role == 'admin'; }
    function isTeacher() {
      return signedIn() && (
        exists(/databases/$(database)/documents/teachers/$(request.auth.uid)) ||
        (hasUserDoc() && get(userPath()).data.role == 'teacher'));
    }
    function isStaff() { return isAdmin() || isTeacher(); }
    function isOwner(id) { return signedIn() && request.auth.uid == id; }
    function same(field) {
      return request.resource.data.get(field, null) == resource.data.get(field, null);
    }

    // ---- Profiles -------------------------------------------------------
    match /users/{id} {
      allow get: if isOwner(id) || isStaff();
      allow list: if isStaff();
      // Self-registration may only ever create an active STUDENT profile.
      allow create: if isOwner(id)
        && request.resource.data.role == 'student'
        && request.resource.data.get('status', 'active') == 'active'
        && request.resource.data.uid == id
        && request.resource.data.keys().hasOnly([
          'uid','name','email','phone','classLevel','studentClass','group',
          'shift','roll','role','status','createdAt']);
      // Owners can edit their profile but never role/status/uid.
      allow update: if isAdmin() || (isOwner(id)
        && same('role') && same('status') && same('uid') && same('createdAt'));
      allow delete: if isAdmin();
    }
    match /teachers/{id} {
      allow get: if isOwner(id) || isStaff();
      allow list: if isStaff();
      allow write: if isAdmin();
    }
    match /students/{id} {
      allow get: if isOwner(id) || isStaff();
      allow list: if isStaff();
      allow write: if isAdmin();
    }

    // ---- Public / learner content --------------------------------------
    match /courses/{id} {
      allow read: if true;
      allow write: if isStaff();
    }
    match /{coll}/{id} {
      allow read: if signedIn() && coll in ['notes','videos','documents'];
      allow write: if isStaff() && coll in ['notes','videos','documents'];
    }

    // ---- Exams ----------------------------------------------------------
    match /exams/{id} {
      allow read: if signedIn();
      allow write: if isStaff();
      // KNOWN GAP: question docs hold `correctIndex`, and the current
      // student screens read them to grade on-device. Students can
      // therefore read answer keys. Fix = move keys to a staff-only
      // subcollection and grade server-side (Phase 6).
      match /questions/{qid} {
        allow read: if signedIn();
        allow write: if isStaff();
      }
    }

    // ---- Video comments (nested) ---------------------------------------
    match /videos/{vid}/comments/{cid} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isStaff() || (signedIn() && resource.data.userId == request.auth.uid);
      match /replies/{rid} {
        allow read: if signedIn();
        allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
        allow update, delete: if isStaff() || (signedIn() && resource.data.userId == request.auth.uid);
      }
    }

    // ---- Suggestions / feedback ----------------------------------------
    match /suggestions/{id} {
      allow read: if signedIn();
      allow create, update, delete: if isStaff();
    }
    match /suggestion_feedback/{id} {
      allow create: if true
        && request.resource.data.message is string
        && request.resource.data.message.size() <= 2000;
      allow read, update, delete: if isStaff();
    }

    // ---- Messaging ------------------------------------------------------
    match /chats/{chatId} {
      allow read: if isAdmin() || (signedIn() &&
        (resource.data.teacherId == request.auth.uid ||
         resource.data.studentId == request.auth.uid));
      allow create: if isTeacher() && request.resource.data.teacherId == request.auth.uid;
      allow update: if isTeacher() && resource.data.teacherId == request.auth.uid;
      match /messages/{mid} {
        function chat() {
          return get(/databases/$(database)/documents/chats/$(chatId)).data;
        }
        allow read: if signedIn() &&
          (chat().teacherId == request.auth.uid || chat().studentId == request.auth.uid || isAdmin());
        allow create: if signedIn() && request.resource.data.senderId == request.auth.uid &&
          (chat().teacherId == request.auth.uid || chat().studentId == request.auth.uid);
      }
    }

    // ---- Admissions / attendance (staff only until models are defined) --
    match /admissions/{id} {
      allow read, write: if isStaff();
    }
    match /attendance/{id} {
      allow read, write: if isStaff();
    }
  }
}
